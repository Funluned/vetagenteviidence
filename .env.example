# NCBI 建议提供联系邮箱；仅在需要更高请求配额时填写 API Key。
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# STRING 要求调用方身份；建议填写项目主页或可联系的机构邮箱。
STRING_CALLER_IDENTITY=VetEvidenceAI

# DAVID 正式富集需使用已在 DAVID Web Service 注册的机构邮箱。
DAVID_EMAIL=

# 默认按 ISSN 动态查询 LetPub；缓存 7 天。设为 false 可只用本地回退表。
LETPUB_LOOKUP_ENABLED=true
LETPUB_CACHE_TTL_DAYS=7

# 可选：机构授权或人工核验的期刊分区 CSV，作为 LetPub 失败时的回退。
JOURNAL_RANKINGS_CSV=

# 后续阶段使用。第一轮 PubMed 检索不依赖 LLM Key。
LLM_PROVIDER=
LLM_API_KEY=
